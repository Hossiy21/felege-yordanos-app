# Staging secrets for Kamal. This file holds NO secret values: each line reads
# an environment variable set by the "Deploy to staging" job from the GitHub
# "staging" environment. Never write a real value here.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
POSTGRES_PASSWORD=$STAGING_POSTGRES_PASSWORD
DATABASE_URL=postgres://felege:${STAGING_POSTGRES_PASSWORD}@felege-db-staging:5432/felege
BETTER_AUTH_SECRET=$STAGING_BETTER_AUTH_SECRET
CLOUDFLARE_ORIGIN_CERT=$(cat "$CLOUDFLARE_ORIGIN_CERT_FILE")
CLOUDFLARE_ORIGIN_KEY=$(cat "$CLOUDFLARE_ORIGIN_KEY_FILE")
# Brevo SMTP (same account for staging and production).
SMTP_USER=$BREVO_SMTP_LOGIN
SMTP_PASSWORD=$BREVO_SMTP_KEY
# Google sign-in (OAuth client "felege-web", same names in both environments).
GOOGLE_CLIENT_ID=$GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=$GOOGLE_CLIENT_SECRET
# Cloudflare R2 (API token for this environment's two buckets).
R2_ENDPOINT=$R2_ENDPOINT
R2_ACCESS_KEY_ID=$R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=$R2_SECRET_ACCESS_KEY
# Cloudflare Turnstile on /join (widget for this environment's host).
TURNSTILE_SITE_KEY=$TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=$TURNSTILE_SECRET_KEY
